# Copy to backend/.env for local development. Production values live in
# Fly.io secrets (`fly secrets set KEY=value`) — never commit real values.

# --- Runtime -----------------------------------------------------------------
# Port the axum server binds to. Fly injects this automatically (matches
# fly.toml internal_port). Locally defaults to 8080 if unset.
PORT=8080

# Log filter. See https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=auction_intel_backend=debug,tower_http=debug

# --- Database ----------------------------------------------------------------
# SQLite path. For local dev the default "sqlite:auction_intel.db?mode=rwc"
# is fine; on Fly we mount a volume at /data so state survives deploys.
DATABASE_URL=sqlite:auction_intel.db?mode=rwc

# --- Auth --------------------------------------------------------------------
# Required in production. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production

# --- External APIs -----------------------------------------------------------
# FRED (Federal Reserve Economic Data) — free, get a key at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Census Bureau — free, https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of additional origins to allow (beyond the built-in
# localhost/vercel.app rules). Useful for staging or custom domains.
CORS_EXTRA_ORIGINS=
